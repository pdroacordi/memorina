%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%....%
%......................................%
%......................................%
%...........H........................--%
%P..E...%...P....%.....%.....%.........%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

[entities]
1,8 = {"id": "plate_shadow"}
4,3 = {"id": "house_door", "trigger_path": "plate_shadow", "second_trigger_path": "plate_load"}
4,8 = {"link": "village_empty_house_door", "to_room": "village_lane_west", "arrive_facing": 1}
12,7 = {"id": "house_load", "hang_height": 32.0, "rope_length": 32.0}
12,8 = {"id": "plate_load"}
