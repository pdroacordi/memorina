[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://resources/cutscene/cutscene_stage.gd" id="e1"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_wait.gd" id="e2"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_walk.gd" id="e3"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_face.gd" id="e4"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_step.gd" id="e5"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene.gd" id="e6"]

[sub_resource type="Resource" id="stage_1"]
script = ExtResource("e1")
staging = &"guitar_staging"
child = &""
seconds = 0.2

[sub_resource type="Resource" id="wait_2"]
script = ExtResource("e2")
seconds = 0.3

[sub_resource type="Resource" id="walk_3"]
script = ExtResource("e3")
actor = &"ivo"
mark = &"by_the_stone"
pace = 0.7

[sub_resource type="Resource" id="face_4"]
script = ExtResource("e4")
actor = &"ivo"
toward = &"alba"

[sub_resource type="Resource" id="wait_5"]
script = ExtResource("e2")
seconds = 0.3

[resource]
script = ExtResource("e6")
id = &"flashback_1_take_guitar"
steps = Array[ExtResource("e5")]([SubResource("stage_1"), SubResource("wait_2"), SubResource("walk_3"), SubResource("face_4"), SubResource("wait_5")])
