[ext_resource type="Script" path="res://resources/cutscene/cutscene_wait.gd" id="e2"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene.gd" id="e3"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_step.gd" id="e4"]

[sub_resource type="Resource" id="s1"]
