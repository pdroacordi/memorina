[resource]
script = ExtResource("e_scene")
id = &"final_fragment"
steps = Array[ExtResource("e_step")]([SubResource("open"), SubResource("hold"), SubResource("to_paper"), SubResource("first"), SubResource("second"), SubResource("panel_3"), SubResource("fourth"), SubResource("panel_5"), SubResource("panel_6"), SubResource("panel_7"), SubResource("clear"), SubResource("to_black"), SubResource("end")])
skippable = true
hud_hidden = true
