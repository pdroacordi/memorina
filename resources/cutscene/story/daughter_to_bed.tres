[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://resources/cutscene/cutscene_together.gd" id="e1"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_step.gd" id="e2"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_stage.gd" id="e3"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_bars.gd" id="e4"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_camera.gd" id="e5"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_gesture.gd" id="e6"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_wait.gd" id="e7"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_face.gd" id="e8"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_walk.gd" id="e9"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene.gd" id="e10"]

[sub_resource type="Resource" id="stage_2"]
script = ExtResource("e3")
staging = &"guitar_staging"
child = &"Lowered"
seconds = 0

[sub_resource type="Resource" id="bars_3"]
script = ExtResource("e4")
open = true
seconds = 0.6

[sub_resource type="Resource" id="camera_4"]
script = ExtResource("e5")
targets = Array[StringName]([&"daughter", &"ivo"])
offset = Vector2(0, -40)
zoom = 2
seconds = 0.8

[sub_resource type="Resource" id="together_1"]
script = ExtResource("e1")
steps = Array[ExtResource("e2")]([SubResource("stage_2"), SubResource("bars_3"), SubResource("camera_4")])

[sub_resource type="Resource" id="gesture_5"]
script = ExtResource("e6")
actor = &"daughter"
clip = &"lower_eyes"

[sub_resource type="Resource" id="wait_6"]
script = ExtResource("e7")
seconds = 0.6

[sub_resource type="Resource" id="face_7"]
script = ExtResource("e8")
actor = &"daughter"
toward = &"ivo"
away = true

[sub_resource type="Resource" id="walk_8"]
script = ExtResource("e9")
actor = &"daughter"
pace = 0.5
mark = &"bed_edge"

[sub_resource type="Resource" id="gesture_9"]
script = ExtResource("e6")
actor = &"daughter"
clip = &"sit"

[sub_resource type="Resource" id="wait_10"]
script = ExtResource("e7")
seconds = 0.4

[sub_resource type="Resource" id="gesture_11"]
script = ExtResource("e6")
actor = &"daughter"
clip = &"lie_down"

[sub_resource type="Resource" id="camera_12"]
script = ExtResource("e5")
targets = Array[StringName]([&"daughter"])
offset = Vector2(0, -24)
zoom = 3
seconds = 1.2

[sub_resource type="Resource" id="wait_13"]
script = ExtResource("e7")
seconds = 1.5

[resource]
script = ExtResource("e10")
id = &"daughter_to_bed"
steps = Array[ExtResource("e2")]([SubResource("together_1"), SubResource("gesture_5"), SubResource("wait_6"), SubResource("face_7"), SubResource("walk_8"), SubResource("gesture_9"), SubResource("wait_10"), SubResource("gesture_11"), SubResource("camera_12"), SubResource("wait_13")])
