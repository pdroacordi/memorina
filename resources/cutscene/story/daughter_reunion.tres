[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://resources/cutscene/cutscene_together.gd" id="e1"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_step.gd" id="e2"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_face.gd" id="e3"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_emote.gd" id="e4"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_camera.gd" id="e5"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_talk.gd" id="e6"]
[ext_resource type="Resource" path="res://resources/dialogue/story/daughter_reunion.tres" id="e7"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_walk.gd" id="e8"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_wait.gd" id="e10"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene.gd" id="e12"]

[sub_resource type="Resource" id="ivo_faces"]
script = ExtResource("e3")
actor = &"ivo"
toward = &"daughter"

[sub_resource type="Resource" id="frame_pair"]
script = ExtResource("e5")
targets = Array[StringName]([&"daughter", &"ivo"])
offset = Vector2(0, -40)
zoom = 2
seconds = 1.0

[sub_resource type="Resource" id="together_1"]
script = ExtResource("e1")
steps = Array[ExtResource("e2")]([SubResource("ivo_faces"), SubResource("frame_pair")])

[sub_resource type="Resource" id="still"]
script = ExtResource("e10")
seconds = 0.8

[sub_resource type="Resource" id="she_turns"]
script = ExtResource("e3")
actor = &"daughter"
toward = &"ivo"

[sub_resource type="Resource" id="she_sees"]
script = ExtResource("e4")
actor = &"daughter"
emote = 2
seconds = 0.9

[sub_resource type="Resource" id="she_runs"]
script = ExtResource("e8")
actor = &"daughter"
pace = 1
mark = &"reunion"

[sub_resource type="Resource" id="he_steps_in"]
script = ExtResource("e8")
actor = &"ivo"
pace = 0.4
mark = &"ivo_reunion"

[sub_resource type="Resource" id="together_2"]
script = ExtResource("e1")
steps = Array[ExtResource("e2")]([SubResource("she_runs"), SubResource("he_steps_in")])

[sub_resource type="Resource" id="she_faces"]
script = ExtResource("e3")
actor = &"daughter"
toward = &"ivo"

[sub_resource type="Resource" id="he_faces"]
script = ExtResource("e3")
actor = &"ivo"
toward = &"daughter"

[sub_resource type="Resource" id="together_3"]
script = ExtResource("e1")
steps = Array[ExtResource("e2")]([SubResource("she_faces"), SubResource("he_faces")])

[sub_resource type="Resource" id="talk"]
script = ExtResource("e6")
talk = ExtResource("e7")
speaker = &"daughter"
wait = false

[resource]
script = ExtResource("e12")
id = &"daughter_reunion"
steps = Array[ExtResource("e2")]([SubResource("together_1"), SubResource("still"), SubResource("she_turns"), SubResource("she_sees"), SubResource("together_2"), SubResource("together_3"), SubResource("talk")])
