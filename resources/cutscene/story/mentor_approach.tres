[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://resources/cutscene/cutscene_walk.gd" id="e1"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_wait.gd" id="e2"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_step.gd" id="e3"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene.gd" id="e4"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_face.gd" id="e5"]

[sub_resource type="Resource" id="walk_1"]
script = ExtResource("e1")
actor = &"ivo"
mark = &"ivo_near"
pace = 0.4

[sub_resource type="Resource" id="face_3"]
script = ExtResource("e5")
actor = &"ivo"
toward = &"mentor_home"

[sub_resource type="Resource" id="wait_2"]
script = ExtResource("e2")
seconds = 0.6

[resource]
script = ExtResource("e4")
id = &"mentor_approach"
steps = Array[ExtResource("e3")]([SubResource("walk_1"), SubResource("face_3"), SubResource("wait_2")])
