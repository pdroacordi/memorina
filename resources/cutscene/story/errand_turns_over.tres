[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://resources/cutscene/cutscene_emote.gd" id="e1"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_wait.gd" id="e2"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_step.gd" id="e3"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene.gd" id="e4"]

[sub_resource type="Resource" id="emote_1"]
script = ExtResource("e1")
actor = &"daughter"
emote = 0
seconds = 1
height = 30

[sub_resource type="Resource" id="wait_2"]
script = ExtResource("e2")
seconds = 0.2

[resource]
script = ExtResource("e4")
id = &"errand_turns_over"
steps = Array[ExtResource("e3")]([SubResource("emote_1"), SubResource("wait_2")])
