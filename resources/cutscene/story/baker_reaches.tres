[gd_resource type="Resource" script_class="Cutscene" format=3]

[ext_resource type="Script" path="res://resources/cutscene/cutscene_together.gd" id="e1"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_step.gd" id="e2"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_camera.gd" id="e3"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_wait.gd" id="e4"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene_gesture.gd" id="e5"]
[ext_resource type="Script" path="res://resources/cutscene/cutscene.gd" id="e6"]

[sub_resource type="Resource" id="camera_2"]
script = ExtResource("e3")
targets = Array[StringName]([&"baker", &"ivo"])
offset = Vector2(0, -40)
zoom = 2
seconds = 0.6

[sub_resource type="Resource" id="wait_3"]
script = ExtResource("e4")
seconds = 0.3

[sub_resource type="Resource" id="together_1"]
script = ExtResource("e1")
steps = Array[ExtResource("e2")]([SubResource("camera_2"), SubResource("wait_3")])

[sub_resource type="Resource" id="gesture_4"]
script = ExtResource("e5")
actor = &"baker"
clip = &"two_loaves"

[sub_resource type="Resource" id="wait_5"]
script = ExtResource("e4")
seconds = 1.1

[resource]
script = ExtResource("e6")
id = &"baker_reaches"
steps = Array[ExtResource("e2")]([SubResource("together_1"), SubResource("gesture_4"), SubResource("wait_5")])
