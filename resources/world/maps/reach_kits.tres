[gd_resource type="Resource" script_class="ReachKits" format=3]

[ext_resource type="Script" path="res://resources/world/maps/reach_kits.gd" id="1_kits"]
[ext_resource type="Script" path="res://resources/world/maps/reach_kit.gd" id="2_kit"]
[ext_resource type="Script" path="res://resources/world/maps/reach_milestone.gd" id="3_milestone"]

[sub_resource type="Resource" id="sword"]
script = ExtResource("3_milestone")
id = &"sword"
items = Array[int]([0])
note = "Held from the start in the base kit (user, 2026-10-14: base = movement and sword). STORY-02 lays it on the farmhouse table (legend i, threshold_farmhouse); the kits keep it in the base kit, since it opens no gate and the audit does not model combat, nor the pogo bounce off a struck enemy that the sword gates."

[sub_resource type="Resource" id="opening"]
script = ExtResource("3_milestone")
id = &"opening"
dialogues = Array[StringName]([&"daughter_errand", &"baker_errand", &"daughter_song", &"elder_story"])
note = "The opening's talks, heard in the village before anything else (STORY-03): the errand, the song and the elder's story. The east gate opens on the elder's story (heard_elder_story.tres; \"East gate shut until the elder points east (Recommended)\": \"The village's east gate stays closed (the existing gate barrier) until the elder's story has been heard; his \"East. It's still there.\" is when it opens. The opening always plays in order. The reach audit learns that the opening's talks are part of the starting kit.\", user, 2026-10-15), so every kit starts with them."

[sub_resource type="Resource" id="memorina"]
script = ExtResource("3_milestone")
id = &"memorina"
room = &"lighthouse_interior"
items = Array[int]([1])
note = "The mentor hands it over in the lighthouse (design 04 section 3.3): the cue-only grant of his mentor_gift talk (STORY-03). Opens the west fence and the river trail (owns_memorina.tres)."

[sub_resource type="Resource" id="bloom"]
script = ExtResource("3_milestone")
id = &"bloom"
room = &"bloom_hollow"
skills = Array[int]([0])
songs = Array[int]([6])
restored_guardians = Array[int]([1])
note = "Bloom Guardian: Enraizar + double jump. Chuva is learned in halves (SONG-14): the thrush in woods_edge (half_rain_first, CORE-04) and the songbook in lake_shore_far_niche (half_rain_second, STORY-06)."

[sub_resource type="Resource" id="frost"]
script = ExtResource("3_milestone")
id = &"frost"
room = &"lake_frost_arena"
skills = Array[int]([2])
songs = Array[int]([0])
restored_guardians = Array[int]([0])
note = "Frost Guardian: Congelar + roll. Redoma is learned in halves (SONG-14): the snail in lake_fishing_village (half_bell_jar_first, CORE-04) and the songbook in woods_hut_letter (half_bell_jar_second, STORY-06; moved there 2026-10-29 so a Lake-first player can enter the Caldera, user: \"Move the Redoma book (Recommended)\"). The roll gates nothing."

[sub_resource type="Resource" id="autumn"]
script = ExtResource("3_milestone")
id = &"autumn"
room = &"orchard_arena"
skills = Array[int]([1])
songs = Array[int]([4])
restored_guardians = Array[int]([2])
note = "Autumn guardian: Soltar + wall climb. Vendaval is learned in halves (SONG-14): the kestrel in orchard_windy_gap (half_gale_first, CORE-04) and the songbook in caldera_seesaw_ledge (half_gale_second, STORY-06). Not built (GRD-04): no fight sets its restored flag yet, so its arena is no exit (ReachKitCheck.given)."

[sub_resource type="Resource" id="summer"]
script = ExtResource("3_milestone")
id = &"summer"
room = &"caldera_arena"
songs = Array[int]([2])
restored_guardians = Array[int]([3])
note = "Summer guardian: Sombra. Solsticio is learned in halves (SONG-14): the lizard in caldera_open_crater (half_solstice_first, CORE-04) and the songbook in orchard_ridge_letter (half_solstice_second, STORY-06). Not built (GRD-04): no fight sets its restored flag yet, so its arena is no exit (ReachKitCheck.given). Its flag opens the sun stair grate (guardian_restored_summer.tres)."

[sub_resource type="Resource" id="half_bell_jar_second"]
script = ExtResource("3_milestone")
id = &"half_bell_jar_second"
room = &"woods_hut"
second_halves = Array[int]([1])
note = "Redoma's songbook (woods_hut_letter, STORY-06): the woodcutter's hut needs no song, so it rides along with the memorina kit and every kit after it."

[sub_resource type="Resource" id="half_rain_first"]
