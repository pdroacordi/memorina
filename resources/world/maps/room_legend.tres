[sub_resource type="Resource" id="earth"]
script = ExtResource("2_entry")
symbol = "#"
kind = 0
ground = 1
description = "Earth: soil with a grassy top (the season's top). Enraizar's roots grow from it."

[sub_resource type="Resource" id="stone"]
script = ExtResource("2_entry")
symbol = "S"
kind = 0
ground = 2
description = "Stone: cut masonry. Roots never grow from it - use it where a song must NOT reach."

[sub_resource type="Resource" id="ledge"]
script = ExtResource("2_entry")
symbol = "="
kind = 1
ground = 1
description = "One-way earth ledge, one cell high: jump up through it, stand on it, drop through it."

[sub_resource type="Resource" id="pool"]
script = ExtResource("2_entry")
symbol = "~"
kind = 2
ground = 0
water_layer = ExtResource("3_pool")
description = "Pool water in a pit, seen edge-on: waves, splashes, reflection. A hazard - Ivo does not swim. Fill the pit to where the water should stand."

[sub_resource type="Resource" id="lake"]
script = ExtResource("2_entry")
symbol = "w"
kind = 2
ground = 0
water_layer = ExtResource("4_lake")
description = "Lake in front of the land, seen from above: opaque, a straight far shore. Paint it over the ground down to the room's bottom, and run it off the room's sides."

[sub_resource type="Resource" id="freezable"]
script = ExtResource("2_entry")
symbol = "f"
kind = 2
ground = 0
water_layer = ExtResource("5_freezable")
description = "Pool water that Congelar freezes into a floor from where the song was played, and that thaws from there."

[sub_resource type="Resource" id="rain"]
script = ExtResource("2_entry")
symbol = "r"
kind = 2
ground = 0
water_layer = ExtResource("i17_rain")
description = "A basin Chuva fills: paint it up to where the rain brings the water. It is dry until it rains, rises while a Chuva pulse covers it, sinks back to dry when the last pulse leaves, and freezes like f (Chuva then Congelar: ice where there was no water)."

[sub_resource type="Resource" id="floater"]
script = ExtResource("2_entry")
symbol = "O"
kind = 3
ground = 0
scene = ExtResource("i18_floater")
anchor = 0
description = "A fallen log that floats: it lies where placed until water reaches it, then rides the waterline (a one-way platform). Chuva's basin lifts it, and Ivo with it."

[sub_resource type="Resource" id="brute"]
script = ExtResource("2_entry")
symbol = "B"
kind = 3
ground = 0
scene = ExtResource("6_brute")
anchor = 0
required_params = PackedStringArray("save_id")
description = "Brute Shadow: a common enemy that wanders, chases and swings. Needs a save_id unique across every map: it stays down until the next rest or death."

[sub_resource type="Resource" id="wind"]
script = ExtResource("2_entry")
symbol = "W"
kind = 3
ground = 0
scene = ExtResource("7_wind")
anchor = 0
description = "A natural current: a box of air standing on this cell (size in px, centred on the cell, rising from its floor) blowing one way, gusting through its profile. Vendaval adds to it; Congelar stops it; the grey stills it."

[sub_resource type="Resource" id="plate"]
script = ExtResource("2_entry")
symbol = "P"
kind = 3
ground = 0
scene = ExtResource("i10_plate")
anchor = 0
description = "A stone pressure plate: holds whatever links to it (trigger_path) while enough weight stands on it - Ivo, his burned shadow, a released load."

[sub_resource type="Resource" id="gate"]
script = ExtResource("2_entry")
symbol = "G"
kind = 3
ground = 0
scene = ExtResource("i11_gate")
anchor = 0
description = "A stone gate standing on this cell that slides up while its trigger_path (a plate) holds, and its second_trigger_path too when set. Any Mechanism: travel, move_time, start_moved."

[sub_resource type="Resource" id="lift"]
script = ExtResource("2_entry")
symbol = "L"
kind = 3
ground = 0
scene = ExtResource("i12_lift")
anchor = 0
description = "A lift platform that rises by travel while its trigger_path holds and sinks back when it lets go; while its lock_path holds (a counterweight on the wrong plate) it is jammed down."

[sub_resource type="Resource" id="seesaw"]
script = ExtResource("2_entry")
symbol = "T"
kind = 3
ground = 0
scene = ExtResource("i13_seesaw")
anchor = 0
description = "A seesaw on its pivot, leaning toward the heavier side by torque (mass times distance) - a shadow on one end raises the other."

[sub_resource type="Resource" id="load"]
script = ExtResource("2_entry")
symbol = "H"
kind = 3
ground = 0
scene = ExtResource("i14_load")
anchor = 0
description = "A heavy cocoon on a rope, hang_height above this floor: Soltar cuts the rope, it falls, weighs a plate, rides Vendaval, and returns to its rope when the grey comes back."

[sub_resource type="Resource" id="cover"]
script = ExtResource("2_entry")
symbol = "F"
kind = 3
ground = 0
scene = ExtResource("i15_cover")
anchor = 0
description = "A curtain of dry leaves blocking a passage (size in px, standing on this cell): Soltar drops it, the grey grows it back - not while someone stands inside."

[sub_resource type="Resource" id="bridge"]
script = ExtResource("2_entry")
symbol = "D"
kind = 3
ground = 0
scene = ExtResource("i16_bridge")
anchor = 0
description = "A drawbridge hinged at the bottom centre of this cell, held up: Soltar lets it fall across length_cells toward side (1 right, -1 left); the grey hauls it back up."

[sub_resource type="Resource" id="bench"]
script = ExtResource("2_entry")
symbol = "R"
kind = 3
ground = 0
scene = ExtResource("i19_bench")
anchor = 0
required_params = PackedStringArray("bench_id")
description = "A bench, standing on this cell: down sits Ivo on it, which heals him, brings the creatures back and saves; a death returns him here. Full shelter from the wind. Needs a bench_id unique across every map."

[resource]
script = ExtResource("1_legend")
entries = Array[ExtResource("2_entry")]([SubResource("earth"), SubResource("stone"), SubResource("ledge"), SubResource("pool"), SubResource("lake"), SubResource("freezable"), SubResource("brute"), SubResource("wind"), SubResource("plate"), SubResource("gate"), SubResource("lift"), SubResource("seesaw"), SubResource("load"), SubResource("cover"), SubResource("bridge"), SubResource("rain"), SubResource("floater"), SubResource("bench")])
