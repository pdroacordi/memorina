[gd_resource type="Resource" script_class="DialogueSet" format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_set.gd" id="f_set"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue.gd" id="f_dialogue"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="f_line"]
[ext_resource type="Script" path="res://resources/save_facts/save_fact.gd" id="f_fact"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("f_line")
cue = &"flashback_2_pick_3"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("f_line")
cue = &"flashback_2_chest"

[sub_resource type="Resource" id="fact_3"]
script = ExtResource("f_fact")
kind = 15
index = 2

[sub_resource type="Resource" id="fact_4"]
script = ExtResource("f_fact")
kind = 7
id = &"flashback_2_ask"

[sub_resource type="Resource" id="fact_5"]
script = ExtResource("f_fact")
kind = 7
id = &"flashback_2_flower_1"

[sub_resource type="Resource" id="fact_6"]
script = ExtResource("f_fact")
kind = 7
id = &"flashback_2_flower_2"

[sub_resource type="Resource" id="fact_7"]
script = ExtResource("f_fact")
kind = 7
id = &"flashback_2_flower_3"

[sub_resource type="Resource" id="dialogue_flashback_2_flower_3_last"]
script = ExtResource("f_dialogue")
id = &"flashback_2_flower_3_last"
once = true
when = Array[ExtResource("f_fact")]([SubResource("fact_3"), SubResource("fact_4"), SubResource("fact_5"), SubResource("fact_6")])
unless = Array[ExtResource("f_fact")]([SubResource("fact_7")])
lines = Array[ExtResource("f_line")]([SubResource("line_1"), SubResource("line_2")])

[sub_resource type="Resource" id="line_8"]
script = ExtResource("f_line")
cue = &"flashback_2_pick_3"

[sub_resource type="Resource" id="fact_9"]
script = ExtResource("f_fact")
kind = 15
index = 2

[sub_resource type="Resource" id="fact_10"]
script = ExtResource("f_fact")
kind = 7
id = &"flashback_2_ask"

[sub_resource type="Resource" id="fact_11"]
script = ExtResource("f_fact")
kind = 7
id = &"flashback_2_flower_3_last"

[sub_resource type="Resource" id="dialogue_flashback_2_flower_3"]
script = ExtResource("f_dialogue")
id = &"flashback_2_flower_3"
once = true
when = Array[ExtResource("f_fact")]([SubResource("fact_9"), SubResource("fact_10")])
unless = Array[ExtResource("f_fact")]([SubResource("fact_11")])
lines = Array[ExtResource("f_line")]([SubResource("line_8")])

[resource]
script = ExtResource("f_set")
dialogues = Array[ExtResource("f_dialogue")]([SubResource("dialogue_flashback_2_flower_3_last"), SubResource("dialogue_flashback_2_flower_3")])
