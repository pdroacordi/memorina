[gd_resource type="Resource" script_class="DialogueSet" format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_set.gd" id="f_set"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue.gd" id="f_dialogue"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="f_line"]
[ext_resource type="Script" path="res://resources/save_facts/save_fact.gd" id="f_fact"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/alba.tres" id="s_alba"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/ivo.tres" id="s_ivo"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("f_line")
speaker = ExtResource("s_ivo")
text_key = "DLG_FLASHBACK_2_02"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("f_line")
speaker = ExtResource("s_alba")
text_key = "DLG_FLASHBACK_2_03"

[sub_resource type="Resource" id="line_3"]
script = ExtResource("f_line")
speaker = ExtResource("s_alba")
text_key = "DLG_FLASHBACK_2_04"
cue = &"flashback_2_tie"

[sub_resource type="Resource" id="line_4"]
script = ExtResource("f_line")
speaker = ExtResource("s_alba")
text_key = "DLG_FLASHBACK_2_05"
cue = &"flashback_2_leaving"

[sub_resource type="Resource" id="fact_5"]
script = ExtResource("f_fact")
kind = 15
index = 2

[sub_resource type="Resource" id="fact_6"]
script = ExtResource("f_fact")
kind = 9
id = &"flashback_2_chest"

[sub_resource type="Resource" id="dialogue_flashback_2_pale"]
script = ExtResource("f_dialogue")
id = &"flashback_2_pale"
once = true
when = Array[ExtResource("f_fact")]([SubResource("fact_5"), SubResource("fact_6")])
lines = Array[ExtResource("f_line")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3"), SubResource("line_4")])
zoom = 2.0

[sub_resource type="Resource" id="line_7"]
script = ExtResource("f_line")
speaker = ExtResource("s_alba")
text_key = "DLG_FLASHBACK_2_01"

[sub_resource type="Resource" id="fact_8"]
script = ExtResource("f_fact")
kind = 15
index = 2

[sub_resource type="Resource" id="dialogue_flashback_2_ask"]
script = ExtResource("f_dialogue")
id = &"flashback_2_ask"
once = true
when = Array[ExtResource("f_fact")]([SubResource("fact_8")])
lines = Array[ExtResource("f_line")]([SubResource("line_7")])
zoom = 2.0

[resource]
script = ExtResource("f_set")
dialogues = Array[ExtResource("f_dialogue")]([SubResource("dialogue_flashback_2_pale"), SubResource("dialogue_flashback_2_ask")])
