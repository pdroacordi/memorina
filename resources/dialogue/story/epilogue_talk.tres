[gd_resource type="Resource" script_class="DialogueSet" format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_set.gd" id="f_set"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue.gd" id="f_dialogue"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="f_line"]
[ext_resource type="Script" path="res://resources/dialogue/line_variant.gd" id="f_variant"]
[ext_resource type="Script" path="res://resources/save_facts/save_fact.gd" id="f_fact"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/ivo.tres" id="s_ivo"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/alba.tres" id="s_alba"]
[ext_resource type="Resource" path="res://resources/save_facts/tone_leans_hold_on.tres" id="f_hold_on"]
[ext_resource type="Resource" path="res://resources/save_facts/tone_leans_let_go.tres" id="f_let_go"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("f_line")
speaker = ExtResource("s_alba")
text_key = "DLG_EPILOGUE_01"

[sub_resource type="Resource" id="v_2_1"]
script = ExtResource("f_variant")
when = Array[ExtResource("f_fact")]([ExtResource("f_hold_on")])
text_key = "DLG_EPILOGUE_02_V1"

[sub_resource type="Resource" id="v_2_2"]
script = ExtResource("f_variant")
when = Array[ExtResource("f_fact")]([ExtResource("f_let_go")])
text_key = "DLG_EPILOGUE_02_V2"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("f_line")
speaker = ExtResource("s_ivo")
text_key = "DLG_EPILOGUE_02"
variants = Array[ExtResource("f_variant")]([SubResource("v_2_1"), SubResource("v_2_2")])

[sub_resource type="Resource" id="talk"]
script = ExtResource("f_dialogue")
id = &"epilogue_talk"
lines = Array[ExtResource("f_line")]([SubResource("line_1"), SubResource("line_2")])

[resource]
script = ExtResource("f_set")
dialogues = Array[ExtResource("f_dialogue")]([SubResource("talk")])
