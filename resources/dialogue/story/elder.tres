[gd_resource type="Resource" script_class="DialogueSet" format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_set.gd" id="f_set"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue.gd" id="f_dialogue"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="f_line"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_choice.gd" id="f_choice"]
[ext_resource type="Script" path="res://resources/dialogue/line_variant.gd" id="f_variant"]
[ext_resource type="Script" path="res://resources/save_facts/save_fact.gd" id="f_fact"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/elder.tres" id="s_elder"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/elder_model.tres" id="s_elder_model"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("f_line")
speaker = ExtResource("s_elder")
text_key = "DLG_ELDER_WAIT_01"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("f_line")
speaker = ExtResource("s_elder")
text_key = "DLG_ELDER_WAIT_02"

[sub_resource type="Resource" id="line_3"]
script = ExtResource("f_line")
cue = &"elder_painting"

[sub_resource type="Resource" id="line_4"]
script = ExtResource("f_line")
speaker = ExtResource("s_elder")
text_key = "DLG_ELDER_PAINTING_01"

[sub_resource type="Resource" id="line_5"]
script = ExtResource("f_line")
speaker = ExtResource("s_elder")
text_key = "DLG_ELDER_STORY_01"

[sub_resource type="Resource" id="line_6"]
script = ExtResource("f_line")
speaker = ExtResource("s_elder")
text_key = "DLG_ELDER_STORY_02"

[sub_resource type="Resource" id="choice_7"]
script = ExtResource("f_choice")
id = &"elder_wait"
text_key = "DLG_CHOICE_ELDER_WAIT"
tone = 1
reply = Array[ExtResource("f_line")]([SubResource("line_1"), SubResource("line_2")])

[sub_resource type="Resource" id="choice_8"]
script = ExtResource("f_choice")
id = &"elder_painting"
text_key = "DLG_CHOICE_ELDER_PAINTING"
tone = 2
reply = Array[ExtResource("f_line")]([SubResource("line_3"), SubResource("line_4")])

[sub_resource type="Resource" id="line_9"]
script = ExtResource("f_line")
speaker = ExtResource("s_elder")
text_key = "DLG_ELDER_STORY_03"
ask_id = &"elder_story"
choices = Array[ExtResource("f_choice")]([SubResource("choice_7"), SubResource("choice_8")])

[sub_resource type="Resource" id="fact_10"]
script = ExtResource("f_fact")
kind = 7
id = &"daughter_song"

[sub_resource type="Resource" id="dialogue_11"]
script = ExtResource("f_dialogue")
id = &"elder_story"
once = true
when = Array[ExtResource("f_fact")]([SubResource("fact_10")])
lines = Array[ExtResource("f_line")]([SubResource("line_5"), SubResource("line_6"), SubResource("line_9")])

[sub_resource type="Resource" id="line_12"]
script = ExtResource("f_line")
speaker = ExtResource("s_elder_model")
text_key = "DLG_ELDER_RETURN_01"

[sub_resource type="Resource" id="fact_13"]
script = ExtResource("f_fact")
kind = 7
id = &"mentor_gift"

[sub_resource type="Resource" id="dialogue_14"]
script = ExtResource("f_dialogue")
id = &"elder_return"
once = true
when = Array[ExtResource("f_fact")]([SubResource("fact_13")])
lines = Array[ExtResource("f_line")]([SubResource("line_12")])

[sub_resource type="Resource" id="line_15"]
script = ExtResource("f_line")
speaker = ExtResource("s_elder")
text_key = "DLG_ELDER_EMPTY_01"

[sub_resource type="Resource" id="fact_16"]
script = ExtResource("f_fact")
kind = 6
index = 2

[sub_resource type="Resource" id="dialogue_17"]
script = ExtResource("f_dialogue")
id = &"elder_empty"
once = true
when = Array[ExtResource("f_fact")]([SubResource("fact_16")])
lines = Array[ExtResource("f_line")]([SubResource("line_15")])

[resource]
script = ExtResource("f_set")
dialogues = Array[ExtResource("f_dialogue")]([SubResource("dialogue_11"), SubResource("dialogue_14"), SubResource("dialogue_17")])
