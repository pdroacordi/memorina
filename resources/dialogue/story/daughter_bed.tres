[gd_resource type="Resource" script_class="DialogueSet" format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_set.gd" id="f_set"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue.gd" id="f_dialogue"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="f_line"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_choice.gd" id="f_choice"]
[ext_resource type="Script" path="res://resources/dialogue/line_variant.gd" id="f_variant"]
[ext_resource type="Script" path="res://resources/save_facts/save_fact.gd" id="f_fact"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/daughter.tres" id="s_daughter"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("f_line")
speaker = ExtResource("s_daughter")
text_key = "DLG_DAUGHTER_ERRAND_01"

[sub_resource type="Resource" id="fact_2"]
script = ExtResource("f_fact")
kind = 7
id = &"baker_errand"

[sub_resource type="Resource" id="dialogue_3"]
script = ExtResource("f_dialogue")
id = &"daughter_errand"
unless = Array[ExtResource("f_fact")]([SubResource("fact_2")])
lines = Array[ExtResource("f_line")]([SubResource("line_1")])

[sub_resource type="Resource" id="line_4"]
script = ExtResource("f_line")
speaker = ExtResource("s_daughter")
text_key = "DLG_DAUGHTER_TURNED_01"

[sub_resource type="Resource" id="fact_5"]
script = ExtResource("f_fact")
kind = 7
id = &"daughter_song"

[sub_resource type="Resource" id="fact_6"]
script = ExtResource("f_fact")
kind = 7
id = &"mentor_gift"

[sub_resource type="Resource" id="dialogue_7"]
script = ExtResource("f_dialogue")
id = &"daughter_turned"
when = Array[ExtResource("f_fact")]([SubResource("fact_5")])
unless = Array[ExtResource("f_fact")]([SubResource("fact_6")])
lines = Array[ExtResource("f_line")]([SubResource("line_4")])

[sub_resource type="Resource" id="fact_9"]
script = ExtResource("f_fact")
kind = 8
id = &"guitar_lower"

[sub_resource type="Resource" id="variant_8"]
script = ExtResource("f_variant")
when = Array[ExtResource("f_fact")]([SubResource("fact_9")])
text_key = "DLG_DAUGHTER_EYES_01_V1"

[sub_resource type="Resource" id="line_10"]
script = ExtResource("f_line")
speaker = ExtResource("s_daughter")
text_key = "DLG_DAUGHTER_EYES_01"
variants = Array[ExtResource("f_variant")]([SubResource("variant_8")])

[sub_resource type="Resource" id="fact_11"]
script = ExtResource("f_fact")
kind = 6
index = 2

[sub_resource type="Resource" id="dialogue_12"]
script = ExtResource("f_dialogue")
id = &"daughter_eyes"
when = Array[ExtResource("f_fact")]([SubResource("fact_11")])
lines = Array[ExtResource("f_line")]([SubResource("line_10")])

[resource]
script = ExtResource("f_set")
dialogues = Array[ExtResource("f_dialogue")]([SubResource("dialogue_12"), SubResource("dialogue_3"), SubResource("dialogue_7")])
