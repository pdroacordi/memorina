id = &"daughter_song"
once = true
when = Array[ExtResource("f_fact")]([SubResource("fact_21")])
unless = Array[ExtResource("f_fact")]([SubResource("fact_22")])
lines = Array[ExtResource("f_line")]([SubResource("line_6"), SubResource("line_7"), SubResource("line_8"), SubResource("line_9"), SubResource("line_10"), SubResource("line_17"), SubResource("line_18"), SubResource("line_19"), SubResource("line_20")])
zoom = 2.0

[resource]
script = ExtResource("f_set")
dialogues = Array[ExtResource("f_dialogue")]([SubResource("dialogue_5"), SubResource("dialogue_23")])
