text_key = "DLG_DAUGHTER_SONG_05"

[sub_resource type="Resource" id="line_8"]
script = ExtResource("f_line")
speaker = ExtResource("s_daughter")
text_key = "DLG_DAUGHTER_SONG_06"

[sub_resource type="Resource" id="line_9"]
script = ExtResource("f_line")
cue = &"guitar_first"

[sub_resource type="Resource" id="line_10"]
script = ExtResource("f_line")
cue = &"song_fails"

[sub_resource type="Resource" id="line_11"]
script = ExtResource("f_line")
cue = &"guitar_again"

[sub_resource type="Resource" id="line_12"]
script = ExtResource("f_line")
speaker = ExtResource("s_ivo")
text_key = "DLG_DAUGHTER_SONG_07"

[sub_resource type="Resource" id="choice_13"]
script = ExtResource("f_choice")
id = &"guitar_try_again"
text_key = "DLG_CHOICE_GUITAR_TRY_AGAIN"
tone = 1
reply = Array[ExtResource("f_line")]([SubResource("line_11"), SubResource("line_12")])

[sub_resource type="Resource" id="line_14"]
script = ExtResource("f_line")
cue = &"guitar_lowered"

[sub_resource type="Resource" id="line_15"]
script = ExtResource("f_line")
speaker = ExtResource("s_daughter")
text_key = "DLG_DAUGHTER_SONG_08"

[sub_resource type="Resource" id="choice_16"]
script = ExtResource("f_choice")
id = &"guitar_lower"
text_key = "DLG_CHOICE_GUITAR_LOWER"
tone = 2
reply = Array[ExtResource("f_line")]([SubResource("line_14"), SubResource("line_15")])

[sub_resource type="Resource" id="line_17"]
script = ExtResource("f_line")
ask_id = &"morning_song"
choices = Array[ExtResource("f_choice")]([SubResource("choice_13"), SubResource("choice_16")])

[sub_resource type="Resource" id="line_18"]
