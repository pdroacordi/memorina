[gd_resource type="Resource" script_class="DialogueSet" format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_set.gd" id="f_set"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue.gd" id="f_dialogue"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="f_line"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_choice.gd" id="f_choice"]
[ext_resource type="Script" path="res://resources/dialogue/line_variant.gd" id="f_variant"]
[ext_resource type="Script" path="res://resources/save_facts/save_fact.gd" id="f_fact"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/daughter.tres" id="s_daughter"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/ivo.tres" id="s_ivo"]
[ext_resource type="Resource" path="res://resources/dialogue/speakers/elder_offscreen.tres" id="s_elder_offscreen"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("f_line")
speaker = ExtResource("s_daughter")
text_key = "DLG_DAUGHTER_SONG_03"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("f_line")
speaker = ExtResource("s_ivo")
text_key = "DLG_DAUGHTER_SONG_04"

[sub_resource type="Resource" id="fact_3"]
script = ExtResource("f_fact")
kind = 7
id = &"baker_errand"

[sub_resource type="Resource" id="fact_4"]
script = ExtResource("f_fact")
kind = 7
id = &"mentor_gift"

[sub_resource type="Resource" id="dialogue_5"]
script = ExtResource("f_dialogue")
id = &"daughter_bread"
once = true
when = Array[ExtResource("f_fact")]([SubResource("fact_3")])
unless = Array[ExtResource("f_fact")]([SubResource("fact_4")])
lines = Array[ExtResource("f_line")]([SubResource("line_1"), SubResource("line_2")])

[sub_resource type="Resource" id="line_6"]
script = ExtResource("f_line")
speaker = ExtResource("s_daughter")
text_key = "DLG_DAUGHTER_SONG_01"
cue = &"ivo_takes_guitar"

[sub_resource type="Resource" id="line_7"]
script = ExtResource("f_line")
