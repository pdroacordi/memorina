index = 4

[sub_resource type="Resource" id="intent_home_again"]
script = ExtResource("2_intent")
id = &"home_again"
text_key = "INTENT_HOME"
when = Array[ExtResource("3_fact")]([ExtResource("4_restored")])
unless = Array[ExtResource("3_fact")]([ExtResource("5_reunion")])

[sub_resource type="Resource" id="intent_ribbon_2"]
script = ExtResource("2_intent")
id = &"ribbon_2"
text_key = "INTENT_RIBBON"
when = Array[ExtResource("3_fact")]([ExtResource("5_reunion"), SubResource("flashback_2_due")])

[sub_resource type="Resource" id="intent_ribbon_4"]
script = ExtResource("2_intent")
id = &"ribbon_4"
text_key = "INTENT_RIBBON"
when = Array[ExtResource("3_fact")]([ExtResource("5_reunion"), SubResource("flashback_4_due")])

[sub_resource type="Resource" id="intent_garden"]
script = ExtResource("2_intent")
id = &"garden"
text_key = "INTENT_GARDEN"
when = Array[ExtResource("3_fact")]([ExtResource("5_reunion")])
unless = Array[ExtResource("3_fact")]([ExtResource("6_epilogue")])

[resource]
script = ExtResource("1_catalog")
intents = Array[ExtResource("2_intent")]([SubResource("intent_home_again"), SubResource("intent_ribbon_2"), SubResource("intent_ribbon_4"), SubResource("intent_garden"), SubResource("intent_bread"), SubResource("intent_home"), SubResource("intent_elder"), SubResource("intent_east"), SubResource("intent_village")])
